  ],
  "agentConnectors": [
    {
      "id": "contracts-clm",
      "displayName": "ContractS CLM",
      "description": "",
      "toolSource": {
        "remoteMcpServer": {
          "mcpServerUrl": "https://mcp.contracts-cloud.com/mcp",
          "authorization": {
            "type": "OAuthPluginVault",
            "referenceId": "{OAuthクライアント登録ID}"
          }
        }
      }
    }
  ]
